# ================= LChain Agent · 服务器部署配置模板 =================
# 用法：cp deploy/server/.env.server.example .env  然后按注释填写（.env 已被 .gitignore 忽略，不要提交）
# 完整可选项（联网搜索、Skills、并发、报告工作区等）见根目录 .env.example，本模板只列服务器部署必须关注的项。

# ---------- 应用 ----------
APP_NAME=LChain Agent
APP_ENV=prod
APP_HOST=0.0.0.0              # 服务器要对外提供服务必须是 0.0.0.0（本机调试可用 127.0.0.1）
APP_PORT=8000

# ---------- 部署：多节点 + 单个定时任务 ----------
NODE_ID=site1-web-1           # 同一套 MySQL 内唯一；重启后保持不变（用于恢复自己未完成的任务）
NODE_HEARTBEAT_SECONDS=10
NODE_DEAD_SECONDS=60
SHUTDOWN_DRAIN_SECONDS=20

# ---------- 日志 ----------
LOG_DIR=logs                  # 相对项目根目录；多节点同机部署时每个节点配不同目录
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
LOG_ACCESS_CONSOLE=false

# ---------- LLM（必填）----------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_MODEL_OPTIONS=deepseek-flash,deepseek-v4-pro
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# ---------- MySQL（必填）----------
# 用仓库自带 Docker MySQL（deploy/mysql）：mysql+aiomysql://lchain:lchain@127.0.0.1:13306/lchain?charset=utf8mb4
# 用服务器已有 MySQL：改成对应地址；业务表与 checkpoint 表会在启动时自动创建
MYSQL_URL=mysql+aiomysql://lchain:lchain@127.0.0.1:13306/lchain?charset=utf8mb4
MYSQL_POOL_SIZE=20
MYSQL_MAX_OVERFLOW=20

# ---------- Langfuse（可选）----------
# 不填也能跑：程序回退到代码内置提示词，只是没有提示词管理和 Trace 上报
# 用本地 Docker Langfuse：make langfuse-init 会自动填好下面三项
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL=300

# ---------- 企微群回复 ----------
WECOM_BOT_NAME=小助手
# 对接企微发送端：空 = 只落库（/wecom 测试页可用，正式群不发送）
WECOM_OUTBOUND_WEBHOOK=
# 生产环境必须为空（测试用故障注入 / 崩溃演练）
WECOM_FAULT_INJECT=
WECOM_CRASH_AT=

# ---------- 家庭医生 Agent（VBC 分级诊疗）----------
WECOM_FD_ENABLED=true
WECOM_FD_NAME=家庭医生
# 放行状态：DEMO / SHADOW / CLINICIAN_ASSISTED / PRODUCTION_APPROVED
# 演示用低风险观察路径只在 DEMO/SHADOW 生效；每地按机构审批逐级放开
WECOM_FD_RELEASE_STAGE=DEMO
WECOM_FD_OBSERVATION_ENABLED=true
WECOM_FD_EMERGENCY_NUMBER=120
WECOM_FD_MIN_ROUNDS=2
WECOM_FD_MAX_ROUNDS=4
WECOM_FD_PLAN_CARD=true

# ---------- 山区远程问诊（如该地用到，按当地情况填）----------
RURAL_EMERGENCY_NUMBER=120
RURAL_REFERRAL_TARGET=乡镇卫生院
RURAL_COUNTY_HOSPITAL=县人民医院
# 当地条件清单：注入提示词，让建议只落在「做得到」的范围里
# RURAL_LOCAL_RESOURCES=村卫生室一般能做：测体温、量血压、测血糖、外伤清创包扎、口服常用药；……
# RURAL_TRANSPORT_HINT=山路弯多、雨雪天路滑、夜间一般没有班车；……
