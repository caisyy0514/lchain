# ===== Langfuse 自托管（本机开发）。由脚本模板：复制为 .env 后替换 CHANGEME（make langfuse-init 会自动生成） =====
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
TELEMETRY_ENABLED=false

# ---- Postgres ----
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres

# ---- ClickHouse ----
CLICKHOUSE_PASSWORD=CHANGEME

# ---- Redis ----
REDIS_AUTH=CHANGEME

# ---- MinIO（S3 兼容对象存储）----
MINIO_ROOT_PASSWORD=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME

# ---- 首次启动自动创建：组织 / 项目 / API Key / 管理员账号 ----
LANGFUSE_INIT_ORG_ID=lchain-org
LANGFUSE_INIT_ORG_NAME=LChain
LANGFUSE_INIT_PROJECT_ID=lchain-agent
LANGFUSE_INIT_PROJECT_NAME=lchain-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@lchain.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
