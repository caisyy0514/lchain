# ================= 应用 =================
APP_NAME=LChain Agent
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# ================= 部署：多 web 节点 + 单个定时任务进程 =================
# 节点 ID，空 = 主机名:端口。同一节点重启后必须保持不变（才能恢复自己未完成的任务），不同节点必须不同
NODE_ID=
NODE_HEARTBEAT_SECONDS=10
# 超过该时间没有心跳视为节点失联，由定时任务进程接管其未完成的任务
NODE_DEAD_SECONDS=60
# web 节点停止时等待进行中任务完成的最长时间
SHUTDOWN_DRAIN_SECONDS=20

# ================= 日志 =================
# 日志目录（相对路径按项目根目录解析，也可以写绝对路径如 /var/log/lchain）
# 生成 app.log（全部）/ error.log（WARNING 及以上）/ access.log（HTTP 访问），按天切分
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
LOG_ACCESS_CONSOLE=false

# ================= LLM（任意 OpenAI 兼容服务） =================
# OpenAI:    LLM_BASE_URL 留空, LLM_MODEL=gpt-4o-mini
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1
# 通义千问:   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 支持 ${ENV_VAR} 引用系统环境变量
LLM_API_KEY=sk-xxx
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
# 前端可切换的模型列表（逗号分隔）
LLM_MODEL_OPTIONS=gpt-4o-mini,gpt-4o

# ================= 联网搜索 =================
# auto：配置了 TAVILY_API_KEY 就用 Tavily，否则用 ddgs（免 Key，聚合 bing / brave 等）
SEARCH_PROVIDER=auto
SEARCH_MAX_RESULTS=5
SEARCH_REGION=cn-zh
# ddgs 使用的搜索引擎（逗号分隔）；auto 模式会随机选到国内不可用的引擎（mojeek 等）
SEARCH_DDGS_BACKEND=yahoo,bing,yandex
# Tavily（https://tavily.com，每月有免费额度，专为 LLM 优化，结果质量更好）
TAVILY_API_KEY=
# 自建 SearXNG（SEARCH_PROVIDER=searxng 时使用），例如 http://localhost:8888
SEARXNG_URL=
# fetch_webpage 返回正文的最大字符数
FETCH_MAX_CHARS=8000
# 单轮对话最多搜索 / 抓取网页的次数
SEARCH_MAX_CALLS=6
FETCH_MAX_CALLS=4
# 允许 fetch_webpage 访问内网地址（SSRF 风险，默认 false）
FETCH_ALLOW_PRIVATE=false

# ================= Skills =================
SKILLS_DIR=skills
# 报告类 Skill（html/word/ppt-report）的工作区，相当于 medex 沙箱里的 /repo
REPORT_WORKSPACE=data/report_workspace
# PPT 严格校验用的 Open XML SDK 校验器；OWNER=root 要求 root 所有（生产），user 允许当前用户所有（本地开发）
# VALIDATION=required 缺校验器即失败，optional 缺校验器时跳过并在输出中注明
PPT_OPENXML_SDK_VALIDATOR=tools/bin/medex-openxml-sdk-validator
PPT_SDK_VALIDATOR_OWNER=user
PPT_SDK_VALIDATION=required
# PPT 渲染验证（ppt_verify）：LibreOffice 路径、中文字体（空=自动查找）；视觉评审模型（需支持图片输入，空=只做自动检查）
PPT_SOFFICE_PATH=
PPT_CJK_FONT=
PPT_VERIFY_VISION_MODEL=
# AI 生图（skills/imagegen）：OpenAI Images API 兼容服务；KEY 为空则不启用。只传给生图子进程（作为 OPENAI_API_KEY / OPENAI_BASE_URL）
IMAGEGEN_API_KEY=
IMAGEGEN_BASE_URL=
IMAGEGEN_MODEL=gpt-image-2
IMAGEGEN_TIMEOUT=600
IMAGEGEN_MAX_CALLS=6

# ================= Langfuse =================
# 本地自托管：执行 make langfuse-init 会自动填好下面三项
# 使用 Langfuse Cloud：填 Cloud 控制台里的 key，HOST 改为 https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PROMPT_LABEL=production
# 提示词缓存秒数：调试时设 0（每次都拉最新），线上建议 60

# ================= MySQL（企微群回复业务存储，make mysql-up 启动） =================
MYSQL_URL=mysql+aiomysql://lchain:lchain@127.0.0.1:13306/lchain?charset=utf8mb4

# ================= 结构化问诊工作流（app/consult，顶部导航「问诊」） =================
# 生成类节点（提问/分诊/诊断）模型 / 判断类节点（信息提取、阶段判断）模型（空 = LLM_MODEL）
CONSULT_MODEL=
CONSULT_FAST_MODEL=
CONSULT_FAST_REASONING_EFFORT=
# 提示词里带入最近 N 轮对话；状态文件保留的对话轮次上限；节点失败重试次数
CONSULT_RECENT_TURNS=8
CONSULT_MAX_TURNS=60
CONSULT_NODE_MAX_ATTEMPTS=3

# ================= 山区远程问诊工作流（app/rural，顶部导航「山区问诊」） =================
# 生成类节点（提问/就医建议/诊断）模型 / 判断类节点（信息提取、本轮动作）模型（空 = LLM_MODEL）
RURAL_MODEL=
RURAL_FAST_MODEL=
RURAL_FAST_REASONING_EFFORT=
# 提示词里带入最近 N 轮对话；状态文件保留的对话轮次上限；节点失败重试次数
RURAL_RECENT_TURNS=8
RURAL_MAX_TURNS=60
RURAL_NODE_MAX_ATTEMPTS=3
# 本地急救电话 / 最近的一级就医去处 / 上一级医院（写进就医建议与转诊安排）
RURAL_EMERGENCY_NUMBER=120
RURAL_REFERRAL_TARGET=乡镇卫生院
RURAL_COUNTY_HOSPITAL=县人民医院
# 当地条件清单：注入提示词，让建议只落在「做得到」的范围里（做不了的检查会写清到哪一级做）
RURAL_LOCAL_RESOURCES=村卫生室一般能做：测体温、量血压、测血糖、外伤清创包扎、口服常用药；一般做不了化验、X 光、B 超、CT，也没有抗蛇毒血清和手术条件。老人家里通常只有少量常用药。
# 山区转运提示：山路 / 雨雪 / 夜间 / 交通工具，写进转诊建议
RURAL_TRANSPORT_HINT=山路弯多、雨雪天路滑、夜间一般没有班车；能借到摩托、三轮农用车就先往乡镇卫生院送，紧急情况直接打 120，同时让人在村口等车、派人在路边引路。

# ================= 企业微信群回复 Agent =================
WECOM_BOT_NAME=小助手
# 回复生成模型 / 判断类节点模型（空 = LLM_MODEL）；文件解读模型需支持图片输入
WECOM_MODEL=
WECOM_FAST_MODEL=
# 判断类节点的推理强度：none / minimal / low / medium / high / xhigh / ultra / max（空 = 模型默认；写错会被忽略）
WECOM_FAST_REASONING_EFFORT=low
WECOM_DOC_MODEL=deepseek-flash
# 上下文带入最近 N 条消息（≈20 轮）；窗口外未压缩消息达到 TRIGGER 条时后台压缩
WECOM_RECENT_MESSAGES=40
WECOM_SUMMARY_TRIGGER=20
# LangGraph checkpoint（MySQL）断点续跑：节点失败自动重试次数；服务启动时自动续跑中断的执行
WECOM_CHECKPOINT_ENABLED=true
WECOM_NODE_MAX_ATTEMPTS=3
WECOM_RESUME_ON_STARTUP=true
WECOM_RESUME_MAX_AGE_SECONDS=600
WECOM_CHECKPOINT_TTL_DAYS=7
# 测试用：模拟某个节点失败（如 respond），验证断点续跑；线上保持为空
WECOM_FAULT_INJECT=
# 测试用：在指定崩溃点直接杀掉进程（node:<节点> / emit_saved:<动作> / emit_sent:<动作> / ingested / run:graph_done），线上保持为空
WECOM_CRASH_AT=
# 待回复超时（秒）-> @病历经理；定时任务进程（make scheduler）的轮询间隔
WECOM_PENDING_TIMEOUT_SECONDS=120
WECOM_JOB_INTERVAL_SECONDS=15
# 待投递消息超过该时间仍未投递，才由定时任务补投（避免与 web 节点正在进行的投递冲突）
WECOM_REDELIVER_GRACE_SECONDS=60
# 文件上传与解析：保存目录（相对项目根目录）/ 单个文件大小上限 / PDF 最多解析页数（扫描件按图片识别）
WECOM_UPLOAD_DIR=data/uploads
WECOM_MAX_FILE_MB=15
WECOM_PDF_MAX_PAGES=8
WECOM_PUSH_PARSE_GUIDE=true
WECOM_PUSH_SEARCH_GUIDE=true
WECOM_SEVERE_NOTIFY_MANAGER=true
# 回复动作推送地址（对接企微发送端），空 = 只落库，由调用方根据 /api/wecom/reply 的返回自行发送
WECOM_OUTBOUND_WEBHOOK=
# 对外可访问地址：配置后计划卡会随 webhook 下发 /wecom-card/{message_id} 链接（患者手机可直接打开）
APP_PUBLIC_URL=
WECOM_DOCTOR_CARD_TITLE=找医生 · 在线问诊
WECOM_DOCTOR_CARD_DESC=点击卡片，选择合适的医生为您进一步诊疗
WECOM_DOCTOR_CARD_URL=https://example.com/find-doctor
# 卡片头像图片地址（测试页默认用内置 /static/assets/doctor-avatar.png；对接真实企微发送端要换成可公网访问的图片地址）
WECOM_DOCTOR_CARD_AVATAR=/static/assets/doctor-avatar.png
# 卡片上的医生名（团队名或医生姓名，留空不显示）
WECOM_DOCTOR_CARD_DOCTOR_NAME=

# ================= 家庭医生 Agent（VBC 分级诊疗 / 就医路径导航） =================
# 启用后，医疗类消息走「确定性安全门控 + 结构化分诊 + 患者计划卡」流程（第 20/23/24 节）
WECOM_FD_ENABLED=true
# 家庭医生在群里的显示名
WECOM_FD_NAME=家庭医生
# 放行状态：DEMO / SHADOW / CLINICIAN_ASSISTED / PRODUCTION_APPROVED
# 演示用低风险观察路径仅在 DEMO / SHADOW 生效；PRODUCTION_APPROVED 前必须替换为医学组审核通过的规则与本机构路径
WECOM_FD_RELEASE_STAGE=DEMO
# 居家观察主动追问（需要 make scheduler 在跑；关闭时不允许 self_care）
WECOM_FD_OBSERVATION_ENABLED=true
# 所在地急救电话（中国大陆 120；境外需换成当地已核验号码）
WECOM_FD_EMERGENCY_NUMBER=120
# 分诊 / 复评模型（空 = LLM_MODEL）
WECOM_FD_MODEL=
WECOM_FD_FAST_MODEL=
# 回复时附带结构化计划卡（前端渲染）；开启时群里只发一句引导，完整规划由卡片承载
WECOM_FD_PLAN_CARD=true
# 普通病例结论前的最少问诊轮次（急症/稳定复诊除外）；避免只问一轮就下结论
WECOM_FD_MIN_ROUNDS=2
# 最多问诊轮次，超过后按现有信息给保守结论
WECOM_FD_MAX_ROUNDS=4

# ================= eval 用例 =================
# 用例目录（每个功能一个子目录，一个用例一个 .md，见 eval/README.md）
EVAL_DIR=eval

# ================= 并发与性能（高并发部署时调） =================
# 事件循环线程池（asyncio.to_thread 用：提示词拉取、Langfuse flush、文件/图片处理）
APP_THREAD_POOL_SIZE=64
# uvicorn 最大并发连接数（0=不限）与等待队列长度
APP_LIMIT_CONCURRENCY=0
APP_BACKLOG=2048
# LLM 客户端：单次请求超时（秒）与网络抖动重试次数；客户端按参数复用（共享连接池）
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
# Langfuse 提示词缓存秒数；0=每次请求都同步拉 Langfuse（会阻塞事件循环，不建议）
LANGFUSE_PROMPT_CACHE_TTL=300
# MySQL 连接池：并发上限 ≈ MYSQL_POOL_SIZE + MYSQL_MAX_OVERFLOW
MYSQL_POOL_SIZE=20
MYSQL_MAX_OVERFLOW=20
